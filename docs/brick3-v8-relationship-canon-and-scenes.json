  "events": [
    {
      "id": "pei_v8_unfinished_past",
      "characterId": "pei_zhiyu",
      "title": "沒有說完的話",
      "requires": [
        "past_relationship_confirmed",
        "no_active_no_contact_boundary"
      ],
      "delivery": {
        "independentOfChatOpen": true,
        "channel": "KKT",
        "pace": "sequential",
        "waitForPlayer": true
      },
      "messages": [
        "我今天整理資料，翻到我們以前一起買的那本書。",
        "本來沒打算跟妳說。",
        "妳還留著那本嗎？"
      ],
      "choices": [
        {
          "id": "pei_past_a",
          "text": "還在。你突然提這個做什麼？",
          "reply": [
            "因為我看到了。",
            "也因為我還記得，那天是妳挑的。",
            "我不是要妳現在給我答案。"
          ]
        },
        {
          "id": "pei_past_b",
          "text": "你是不是想跟我談以前的事？",
          "reply": [
            "是。",
            "只是我不知道妳現在願不願意聽。",
            "如果不願意，我就不提。"
          ]
        },
        {
          "id": "pei_past_c",
          "text": "不記得了，你想說什麼？",
          "reply": [
            "沒什麼特別重要的。",
            "只是今天想起來，有點放不下。"
          ]
        },
        {
          "id": "pei_past_d",
          "text": "過去的事情我暫時不想談。",
          "reply": [
            "好。",
            "我不會再拿這件事追問妳。"
          ],
          "effects": {
            "respectBoundary": "past_discussion"
          }
        }
      ]
    },
    {
      "id": "pei_v8_secret_offer",
      "characterId": "pei_zhiyu",
      "title": "只要還能留在妳身邊",
      "requires": [
        "player_has_confirmed_other_partner",
        "pei_knows_partner_from_traceable_source",
        "unresolved_shared_history",
        "pei_wants_reconciliation",
        "no_active_no_contact_boundary",
        "no_prior_explicit_refusal_of_secret_relationship"
      ],
      "delivery": {
        "independentOfChatOpen": true,
        "channel": "KKT",
        "pace": "sequential",
        "waitForPlayer": true
      },
      "messages": [
        "我知道妳現在跟別人在一起。",
        "這件事我不是今天才知道。",
        "我想了很久，還是想問妳一件事。",
        "如果不能像以前那樣，我們還有沒有別的可能？"
      ],
      "choices": [
        {
          "id": "pei_secret_a",
          "text": "你是在說，即使不能公開也要在一起？",
          "reply": [
            "……對。",
            "我知道這聽起來很難看。",
            "但我不是在替妳做決定。妳不願意，就當我沒提過。"
          ],
          "effects": {
            "openNegotiation": true,
            "confirmRelationship": false
          }
        },
        {
          "id": "pei_secret_b",
          "text": "你明知道我已經有男朋友了。",
          "reply": [
            "我知道。",
            "所以我才一直不敢說。",
            "我沒資格要妳為我改變什麼。"
          ],
          "effects": {
            "confirmRelationship": false
          }
        },
        {
          "id": "pei_secret_c",
          "text": "我不想讓我們變成這樣。",
          "reply": [
            "……好。",
            "我聽懂了。",
            "我不會再拿這個要求妳。"
          ],
          "effects": {
            "refuseSecretOffer": true,
            "confirmRelationship": false
          }
        },
        {
          "id": "pei_secret_d",
          "text": "我需要時間想想。",
          "reply": [
            "好。",
            "我不催妳。",
            "但如果妳不想回答，也可以直接跟我說。"
          ],
          "effects": {
            "setPendingDecision": true,
            "confirmRelationship": false
          }
        }
      ]
    },
    {
      "id": "lu_v8_after_meeting",
      "characterId": "lu_chenchuan",
      "title": "會議後的第一次交談",
      "requires": [
        "lu_work_meeting_occurred",
        "player_and_lu_both_attended",
