  "rules": {
    "beforeGeneration": [
      "讀取 stories/visual-memory/index.json，依角色 ID 讀取對應 characters/<id>.json，確認外貌已鎖定",
      "實際載入 referencedImage.repositoryPath 的圖片及 approvedAppearance；只知道角色姓名不足以生成角色本人",
      "依事件真實發生的時間、地點與角色生活，選擇拍攝視角、光線及道具；未確定事實不能補寫",
      "確定用途是 kkt_chat／instagram_story／instagram_post，遵循對應 assetRouting"
    ],
    "atDelivery": [
      "逐張註明角色、用途、拍攝情境、檔名、相對路徑及對應 GitHub 資料夾連結",
      "如已實際提交照片，附 commit 與檔案連結；未提交則明示本地檔案與待上傳狀態",
      "新增圖片需在相關照片事件配置中依劇情條件引用；光有檔案不等於遊戲已生效"
    ],
    "noNameOnlyGeneration": true,
    "doNotInventCanonFromReferenceSheetLabels": true,
    "protectExistingIdentityLocks": true,
    "allowCanonChangesOnlyAfterUserExplicitApproval": true,
    "sceneBasedVarietyRatherThanIdenticalComposition": true
  },
  "pendingCharactersPolicy": "朋友與其他人物若尚未明確核准外貌，不可擅自建立『已鎖定』身分；首次確認時新增一個角色獨立檔，再加入此索引。"
}
