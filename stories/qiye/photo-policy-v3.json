  "moodPhotoMapping": {
    "happy": {
      "subjects": [
        "贏球",
        "得意自拍",
        "朋友聚會",
        "新物品",
        "完成設計"
      ],
      "messageStyle": [
        "得意",
        "玩笑",
        "炫耀成果"
      ]
    },
    "excited": {
      "subjects": [
        "活動連拍",
        "球場照",
        "朋友合理幫拍"
      ],
      "maySendSequence": true,
      "alwaysSendSequence": false
    },
    "calm": {
      "subjects": [
        "普通自拍",
        "穿搭",
        "食物",
        "街景",
        "草圖",
        "房間角落"
      ],
      "specialMeaningRequired": false
    },
    "bored": {
      "subjects": [
        "莫名其妙的自拍",
        "沙發坐著"
      ],
      "mayComplain": true,
      "mayEndAfterSending": true
    },
    "tired": {
      "subjects": [
        "運動後",
        "鞋子",
        "桌面凌亂",
        "未完成設計稿",
        "休息"
      ],
      "messagesCanBeShort": true
    },
    "angry": {
      "mayChooseNoPhotos": true,
      "subjectMustRelateToEvent": true,
      "noRoutineViolence": true
    },
    "sad": {
      "subjects": [
        "空球場",
        "夜路",
        "沒笑容的自拍",
        "房間角落",
        "相關物件"
      ],
      "responsePatterns": [
        "可能嘴硬",
        "可能直接承認"
      ],
      "noFixedDenialThenConfession": true
    }
  },
  "outingPhotography": {
    "onlyIfConfirmedSharedOutingAndPhotogenicEvent": true,
    "longTermReferenceWeights": {
      "selfCaptured": 0.5,
      "companionCaptured": 0.2,
      "groupPhotoWithKnownNPC": 0.3
    },
    "photographerMustExistInScene": true,
    "companionsMustHaveExistingIdentity": true,
    "useCompanionVisualMemoryIfVisible": true,
    "noInventedFriends": true,
    "noPlayerNPCJointPhotos": true,
    "notEveryOutingRequiresPhoto": true
  },
  "captureDecisionFactors": [
    "當天行程",
    "當前事件",
    "情緒狀態",
    "分享動機",
    "玩家關係狀態",
    "是否忙碌",
    "此前對話及事件"
  ],
  "autonomy": {
    "captureCanOccurWhenPlayerChatClosed": true,
    "sendCanOccurWhenPlayerChatClosed": true,
    "noFixedDailyCaptureQuota": true,
    "noFixedDailySendQuota": true,
    "openingChatDoesNotTriggerGeneration": true,
    "captureWithoutSendingAllowed": true,
    "maySendOneImageNoText": true,
    "maySendOneShortLine": true,
    "maySendThenResumeLife": true,
    "mayProvideLaterExplanation": true,
    "mayNotReplyUntilAvailable": true,
    "mayDecideNotToCaptureOrNotToSend": true,
    "doesNotShareEverything": true
  },
  "messageInteraction": {
    "useRealisticTurnTaking": true,
    "fourMeaningfullyDifferentPlayerChoicesPerResponseNode": true,
    "respondToPlayerSelectionFirst": true,
    "pauseIfPlayerBusy": true,
    "doNotForceContinuedConversation": true,
    "prohibitRepeatedOpeners": [
      "喂",
      "怎樣",
      "不然呢"
    ],
    "noPersistentOneLiners": true,
    "noPersistentTeasing": true,
    "noPersistentRomanticFlirting": true,
    "noMessageFlooding": true,
    "noIgnoringPlayerReply": true
  },
