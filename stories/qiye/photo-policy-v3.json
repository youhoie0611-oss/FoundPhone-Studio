  "photoRecordSchema": {
    "id": "string stable unique",
    "photoStatus": [
      "not_captured",
      "captured"
    ],
    "photographerId": "string or null",
    "subjectIds": "array<string>",
    "capturedAt": "in-game timestamp or null",
    "locationId": "string or null",
    "storyEventId": "string or null",
    "characterMood": "string or null",
    "wardrobeStateId": "string or null",
    "assetPath": "existing project asset path or null",
    "assetGitHubStatus": [
      "pending_upload",
      "uploaded",
      "verified"
    ],
    "sharingDecision": [
      "undecided",
      "share",
      "dont_share"
    ],
    "deliveryStatus": [
      "not_scheduled",
      "scheduled",
      "delivered",
      "cancelled"
    ],
    "deliveryTime": "in-game timestamp or null",
    "chatMessageId": "string or null",
    "readStatus": [
      "unread",
      "read",
      "not_applicable"
    ],
    "reuseLockedOriginalAsset": true
  },
  "separatePhases": [
    "capture",
    "choose_to_share",
    "deliver"
  ],
  "gameConstraints": {
    "singlePlayer": true,
    "playerRepliesViaChoicesOnly": true,
    "noRealPhoneCamera": true,
    "noPlayerImageUpload": true,
    "noPlayerWithNPCPhotos": true,
    "npcNeverRequestsPlayerPhoto": true,
    "noPhotoExchangeSystem": true,
    "offlineCharactersCanSend": true,
    "persistentUnreadPhotos": true,
    "openingChatShowsHistoryNotNewRandomScene": true,
    "sharedAcrossAllCharacters": true,
    "assetsPreGeneratedAtAuthoringTime": true
  },
  "eventFlow": [
    "read_current_time_and_location",
    "read_activity_and_schedule",
    "read_mood_and_story_state",
    "decide_whether_capture",
    "choose_subject",
    "choose_valid_photographer_and_viewpoint",
    "load_qiye_visual_memory_and_real_reference_pixels",
    "load_visible_npc_visual_memories",
    "validate_outfit_people_scene_time_and_camera",
    "create_and_save_asset_during_authoring_not_during_runtime",
    "decide_share_to_player_or_no_share",
    "schedule_send_if_shared",
    "create_in_character_message",
    "persist_unread",
    "branch_on_player_choice",
    "persist_photo_and_chat_history"
  ],
